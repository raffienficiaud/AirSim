#tools.build:cxxflags=['-target x86_64-unknown-linux-gnu',     '-I{{ unreal_base }}/Engine/Source/ThirdParty/Unix/LibCxx/include/',    '-I{{ unreal_base }}/Engine/Source/ThirdParty/Unix/LibCxx/include/c++/v1/','-stdlib=libc++']
#tools.build:sharedlinkflags=['-stdlib=libc++', '-nodefaultlibs', '-L{{ unreal_base }}/Engine/Source/ThirdParty/Unix/LibCxx/lib/Unix/x86_64-unknown-linux-gnu']
#tools.build:exelinkflags=['-stdlib=libc++', '-L{{ unreal_base }}/Engine/Source/ThirdParty/Unix/LibCxx/lib/Unix/x86_64-unknown-linux-gnu']


