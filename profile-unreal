# tools.build:cxxflags=['-nostdinc++', '-I{{ unreal_clang }}/include/c++/13.2.0/', '-I{{ unreal_clang }}/include/c++/13.2.0/x86_64-unknown-linux-gnu']

# Only for rpc
# rpclib/*:tools.build:cxxflags=['-D__GLIBC_USE_C23_STRTOL=0', '-D__GLIBC_USE_C2X_STRTOL=0']
# rpclib/*:tools.build:verbosity=verbose

[settings]
arch=x86_64
build_type=Release
compiler=clang
compiler.cppstd=17
compiler.libcxx=libc++
compiler.version=18
os=Linux

